{
  "$id": "order",
  "type": "object",
  "required": ["id", "items", "promoCode", "subtotal", "discountPercent", "discount", "total", "createdAt"],
  "properties": {
    "id": { "type": "string", "pattern": "^ORD-[0-9]+-[a-f0-9]{8}$" },
    "items": { "type": "array", "minItems": 1 },
    "promoCode": { "type": ["string", "null"] },
    "subtotal": { "type": "integer", "minimum": 1 },
    "discountPercent": { "type": "integer", "minimum": 0 },
    "discount": { "type": "integer", "minimum": 0 },
    "total": { "type": "integer", "minimum": 0 },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
