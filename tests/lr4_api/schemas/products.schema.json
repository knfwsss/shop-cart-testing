{
  "$id": "products",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["id", "name", "price", "stock", "inStock"],
    "properties": {
      "id": { "type": "string", "pattern": "^p[0-9]+$" },
      "name": { "type": "string", "minLength": 1 },
      "price": { "type": "integer", "minimum": 1 },
      "stock": { "type": "integer", "minimum": 0 },
      "inStock": { "type": "boolean" }
    },
    "additionalProperties": false
  }
}
